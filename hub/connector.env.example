# Copy outside Git to a root-owned 0600 file in a 0700 directory.
# No auth key, OAuth secret, login URL or Codex credentials belong in this file.

# Required official immutable image reference: tailscale/tailscale@sha256:<64 hex>.
# Resolve and verify the intended published release at deployment; no default.
TAILSCALE_IMAGE=
CONNECTOR_STATE_DIR=/opt/tailscale-ai-egress/state

# Required. Choose an unused RFC1918 IPv4 CIDR after inspecting every existing
# Docker network and host/LAN/VPN/tailnet route. There is deliberately no default.
CONNECTOR_IPV4_SUBNET=

# Required independent IPv4 DNS upstreams, reachable from the connector's
# network namespace. They must not forward selected app domains to MagicDNS
# or back to this connector. Do not use 100.100.100.100, a tailnet address,
# loopback, or Docker's 127.0.0.11. Public examples: 1.1.1.1 and 9.9.9.9;
# explicitly choose and test resolvers suitable for your network.
CONNECTOR_DNS_IPV4_PRIMARY=
CONNECTOR_DNS_IPV4_SECONDARY=
