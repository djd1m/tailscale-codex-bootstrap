#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C.UTF-8
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ $EUID -ne 0 ]]; then
  exec sudo -- bash "$repo_dir/bin/bootstrap" "$@"
fi
export HOME="$(getent passwd 0 | cut -d: -f6)"
if [[ ! -f /etc/os-release ]]; then
  echo 'Поддерживаются Ubuntu 22.04/24.04 и Debian 12/13 с systemd.' >&2; exit 2
fi
. /etc/os-release
case "${ID:-}:${VERSION_ID:-}" in
  ubuntu:22.04|ubuntu:24.04|debian:12|debian:13) ;;
  *) echo 'Эта ОС пока не прошла проверку совместимости. Установка остановлена.' >&2; exit 2 ;;
esac
case "$(uname -m)" in
  x86_64|aarch64|arm64) ;;
  *) echo 'Поддерживаются amd64 и arm64.' >&2; exit 2 ;;
esac
read -r init_comm </proc/1/comm
if [[ "$init_comm" != systemd ]]; then
  echo 'Нужна VM с systemd; контейнер без systemd не поддерживается.' >&2
  exit 2
fi
missing=()
command -v python3 >/dev/null || missing+=(python3)
command -v tmux >/dev/null || missing+=(tmux)
# An enrolled host must be identified against the approved profile before apt.
if command -v tailscale >/dev/null; then
  if ! command -v python3 >/dev/null; then
    echo 'Уже есть Tailscale, но нет Python. Администратор должен проверить назначение узла и поставить python3 до продолжения.' >&2
    exit 2
  fi
  if (( ${#missing[@]} )); then
    if PYTHONPATH="$repo_dir/src" python3 -m tailnet_bootstrap.cli --launcher-preflight "$@"; then
      :
    else
      preflight_code=$?
      if [[ $preflight_code -eq 3 ]]; then
        exec env PYTHONPATH="$repo_dir/src" python3 -m tailnet_bootstrap.cli "$@"
      fi
      exit "$preflight_code"
    fi
  fi
fi
if (( ${#missing[@]} )); then
  echo 'Для сохраняемой сессии нужны python3 и tmux. Установить? [y/N]'
  read -r answer </dev/tty
  [[ "$answer" == y || "$answer" == Y || "$answer" == да ]] || exit 2
  export DEBIAN_FRONTEND=noninteractive
  timeout 300 apt-get -o Acquire::Retries=3 -o DPkg::Lock::Timeout=60 update
  timeout 600 apt-get -o Acquire::Retries=3 -o DPkg::Lock::Timeout=60 install -y --no-install-recommends "${missing[@]}"
fi
export PYTHONPATH="$repo_dir/src"
if [[ -n ${TMUX:-} ]]; then
  exec python3 -m tailnet_bootstrap.cli "$@"
fi
session=node-bootstrap
socket=ai-egress-bootstrap
if tmux -L "$socket" has-session -t "=$session" 2>/dev/null; then
  echo "Подключаю существующую сессию $session. Её процессы сохраняются."
  exec tmux -L "$socket" attach-session -t "=$session"
fi
printf -v launch 'cd -- %q; python3 -m tailnet_bootstrap.cli' "$repo_dir"
for arg in "$@"; do printf -v escaped '%q' "$arg"; launch+=" $escaped"; done
launch+='; echo; echo "Состояние сохранено. Для повторного запуска: bash bin/bootstrap"; exec bash'
exec tmux -L "$socket" -f "$repo_dir/tmux.conf" new-session -s "$session" "$launch"
